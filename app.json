{
  "expo": {
    "name": "Rutas",
    "slug": "rutas",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rutas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "co.saerling.rutas",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rutas usa tu ubicación solo mientras la tienes abierta, para mostrarte los paraderos y estaciones cerca de ti. No la guardamos.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "es",
        "CFBundleLocalizations": [
          "es",
          "en",
          "pt",
          "fr",
          "de",
          "ja",
          "zh-Hans"
        ],
        "NFCReaderUsageDescription": "Rutas lee tu tarjeta TuLlave en el teléfono para mostrarte el saldo. El número no sale del teléfono.",
        "com.apple.developer.nfc.readersession.iso7816.select-identifiers": [
          "D4100000030001"
        ],
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "co.saerling.rutas.card",
            "UIApplicationShortcutItemTitle": "CardShortcutTitle",
            "UIApplicationShortcutItemIconSymbolName": "wave.3.right"
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "TAG"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.saerling.rutas",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "NFC"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rutas-acme-44c2.vercel.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0B0B0C",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rutas usa tu ubicación solo mientras la tienes abierta, para mostrarte los paraderos y estaciones cerca de ti. No la guardamos."
        }
      ],
      "expo-font",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "NextBus",
              "displayName": "Tu paradero",
              "description": "Los próximos buses de tu primer paradero guardado.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://rutas-acme-44c2.vercel.app",
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json",
      "pt": "./locales/pt.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "ja": "./locales/ja.json",
      "zh-Hans": "./locales/zh-Hans.json"
    }
  }
}
